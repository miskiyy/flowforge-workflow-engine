# API (apps/api)
PORT=3000
DATABASE_URL=postgres://flowforge:local_dev_only@localhost:5433/flowforge
# Comma-separated list of allowed origins. Unset -> reflects any origin in
# development, denies all in production (see apps/api/src/app.ts).
CORS_ORIGIN=
# Signing secret for access tokens. Must be at least 32 chars in production
# (enforced in apps/api/src/config.ts). Never reuse this dev value anywhere real.
JWT_SECRET=local_dev_only_insecure_do_not_use_in_prod
JWT_EXPIRES_IN=15m

# AI subsystem (apps/api/src/ai) — additive, optional. AI_PROVIDER defaults to
# "mock" (no key needed; the API boots and CI passes with none). Set to
# "openrouter" to use a real model — OPENROUTER_API_KEY is then required, but
# only fails AI route registration if missing, never API boot. Never commit a
# real key here — name only, empty value.
AI_PROVIDER=mock
OPENROUTER_API_KEY=
AI_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Dashboard (apps/dashboard) — read at Vite build/dev time, not at runtime.
VITE_API_URL=http://localhost:3000
